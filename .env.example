# --- Chat & Realtime Thresholds ---
WS_MAX_CONNECTIONS=10000
CHAT_CONN_SPIKE_THRESHOLD=500
CHAT_SPIKE_THRESHOLD_WARN=100
CHAT_SPIKE_THRESHOLD_CRITICAL=300

NEXTAUTH_SECRET=super_secret_nextauth_key
WAITLIST_UNSUBSCRIBE_SECRET=waitlist_unsubscribe_secret_123
